<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OrionCache</PackageId>
    <Description>Cache-aside done right for the Orion family: one GetOrCreateAsync that never stampedes (single-flight per key), with expiration driven by an OrionClock TimeProvider so it is deterministic in tests, and an Option-returning TryGetAsync from OrionResult. OpenTelemetry by default, AOT-clean. Wave 1 is the in-memory core; a Redis L2 and tag invalidation land in later waves.</Description>
    <PackageTags>orion;cache;cache-aside;stampede;single-flight;memory;getorcreate;dotnet</PackageTags>
    <RootNamespace>Moongazing.OrionCache</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Orion.Abstractions" Version="1.2.0" />
    <PackageReference Include="OrionClock" Version="0.9.0" />
    <PackageReference Include="OrionResult" Version="0.9.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Moongazing.OrionCache.Tests" />
  </ItemGroup>
</Project>
