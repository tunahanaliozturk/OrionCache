<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OrionCache</PackageId>
    <Description>Cache-aside with per-key single-flight, OrionClock-driven expiration, case-sensitive tag invalidation, Option-returning reads, and OpenTelemetry. AOT-clean in-memory core; Redis L2 is planned.</Description>
    <PackageTags>orion;cache;cache-aside;stampede;single-flight;memory;getorcreate;dotnet</PackageTags>
    <RootNamespace>Moongazing.OrionCache</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Orion.Abstractions" Version="1.2.0" />
    <PackageReference Include="OrionClock" Version="0.9.0" />
    <PackageReference Include="OrionResult" Version="0.9.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Moongazing.OrionCache.Tests" />
  </ItemGroup>
</Project>
